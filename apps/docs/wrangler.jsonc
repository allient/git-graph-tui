{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Static files only, no Worker script: requests to static assets are free
	// and unlimited on Cloudflare Workers.
	"name": "git-graph-tui-docs",
	"compatibility_date": "2026-10-30",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	}
}
